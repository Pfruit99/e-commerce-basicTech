// Modelo de datos de basicTech. Fuente de la documentación: doc/modelo-datos.md.
// Dinero en centavos (Int). La URL de la base se define en prisma.config.ts (DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum OrderStatus {
  PENDING // creado, sin pago confirmado
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  CARD // única en la primera versión; TRANSFER y CASH se añaden con una migración
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  phone        String?
  passwordHash String
  role         Role       @default(CUSTOMER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now())

  addresses Address[]
  orders    Order[]
  favorites Favorite[]
  cart      CartItem[]
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String? // "Casa", "Trabajo"
  line1     String
  city      String
  zip       String
  isDefault Boolean @default(false)

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique // pc, monitores, teclados, mouses, audio, componentes
  name        String
  description String
  filterKeys  String[] // claves de Product.specs usadas como filtros
  products    Product[]
}

model Brand {
  id       String    @id @default(cuid())
  slug     String    @unique
  name     String    @unique
  products Product[]
}

model Product {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  popularity  Int       @default(0)
  isNew       Boolean   @default(false)
  specs       Json // { "RAM": "16 GB", ... } comunes a todas las variantes
  categoryId  String
  brandId     String
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())

  category  Category         @relation(fields: [categoryId], references: [id])
  brand     Brand            @relation(fields: [brandId], references: [id])
  variants  ProductVariant[]
  images    ProductImage[]
  favorites Favorite[]

  @@index([categoryId, brandId])
}

// Todo producto tiene al menos una variante; la que no varía lleva options = {}.
model ProductVariant {
  id         String  @id @default(cuid())
  productId  String
  sku        String  @unique
  options    Json // { "Color": "Negro", "Capacidad": "1 TB" }
  priceCents Int
  stock      Int     @default(0)
  isDefault  Boolean @default(false)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@index([priceCents])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  alt       String?
  position  Int     @default(0)

  @@index([productId])
}

model Favorite {
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
}

model CartItem {
  userId    String
  variantId String
  quantity  Int

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@id([userId, variantId])
}

model Order {
  id            String      @id @default(cuid())
  number        String      @unique // legible, ej. A1B2C3D4
  userId        String
  status        OrderStatus @default(PENDING)
  subtotalCents Int
  shippingCents Int
  totalCents    Int
  // copia de la dirección al momento de comprar
  shipName      String
  shipLine1     String
  shipCity      String
  shipZip       String
  shipPhone     String?
  createdAt     DateTime    @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items    OrderItem[]
  payments Payment[]

  @@index([userId])
  @@index([status, createdAt])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  variantId      String
  nameSnapshot   String // producto + opciones, ej. "SSD NVMe - 1 TB"
  skuSnapshot    String
  unitPriceCents Int
  quantity       Int

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  amountCents Int
  providerRef String?       @unique // id en la pasarela, para el webhook
  createdAt   DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
}
