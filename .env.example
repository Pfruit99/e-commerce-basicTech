# Copia este archivo a .env y cambia los valores. .env no se sube al repositorio.
POSTGRES_USER=basictech
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=basictech
POSTGRES_PORT=5432

# Prisma
DATABASE_URL="postgresql://basictech:cambia-esta-clave@localhost:5432/basictech?schema=public"

# Better Auth. Genera el secreto con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-este-secreto-de-al-menos-32-caracteres
BETTER_AUTH_URL=http://localhost:3000

# Opcional: administrador que crea `npm run db:seed`
SEED_ADMIN_EMAIL=admin@basictech.local
SEED_ADMIN_PASSWORD=cambia-esta-clave-de-admin
SEED_ADMIN_NAME=Administrador
